root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Exec command text is compared byte-for-byte with the Nix source string.
[*.cmd]
insert_final_newline = false
