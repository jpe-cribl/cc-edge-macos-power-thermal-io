/bin/bash -c 'wp=$(/usr/bin/vm_stat | /usr/bin/awk "/Pages wired down/{gsub(/[^0-9]/,\"\",\$4);print \$4}"); pgsz=$(/usr/sbin/sysctl -n hw.pagesize); cm=$(/usr/sbin/sysctl -n iogpu.wired_limit_mb); rk=$(/bin/ps -A -o rss= | /usr/bin/awk "{s+=\$1} END{print s+0}"); /usr/bin/awk -v wp="$wp" -v pgsz="$pgsz" -v cm="$cm" -v rk="$rk" "BEGIN{wb=wp*pgsz; cb=cm*1024*1024; printf \"{\\\"wired_bytes\\\":%d,\\\"wired_ceiling_mb\\\":%d,\\\"wired_ceiling_bytes\\\":%d,\\\"wired_ratio\\\":%.4f,\\\"resident_bytes\\\":%d}\\n\", wb, cm, cb, wb/cb, rk*1024}"'